

PORT=3000

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=biblioteca_db
DB_USER=root
DB_PASS=

JWT_SECRET=cambia_esto_por_una_frase_larga_y_secreta

# Zona horaria de la biblioteca para las fechas de préstamo y devolución.
# Nombres válidos: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
ZONA_HORARIA=America/Lima

# Nivel de detalle de los logs: debug, info, warn o error.
LOG_LEVEL=info
