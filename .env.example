

PORT=3000

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=biblioteca_db
DB_USER=root
DB_PASS=

JWT_SECRET=cambia_esto_por_una_frase_larga_y_secreta

# Zona horaria de la biblioteca para las fechas de préstamo y devolución.
# Nombres válidos: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
ZONA_HORARIA=America/Lima

# Nivel de detalle de los logs: debug, info, warn o error.
LOG_LEVEL=info

# Reglas de préstamo: días para devolver un libro y máximo de préstamos
# o solicitudes activas por lector.
DIAS_PRESTAMO=14
MAX_PRESTAMOS_ACTIVOS=3

# Correo saliente con Resend (recuperar contraseña). Sin clave, en
# desarrollo el correo se muestra en la terminal.
RESEND_API_KEY=
# Remitente con tu dominio verificado en Resend.
CORREO_REMITENTE=Biblioteca <onboarding@resend.dev>
# Dirección pública para los enlaces de los correos. En Railway no hace falta:
# se usa RAILWAY_PUBLIC_DOMAIN.
URL_PUBLICA=http://localhost:3000
